table MART_FINANCIAL_ANOMALIES
	lineageTag: 8ec3cfa4-0fd2-4c4a-81c7-2244d0de9f1e

	measure 'Average Anomaly Severity' =
			
			AVERAGEX (
			    FILTER (
			        MART_FINANCIAL_ANOMALIES,
			        NOT ISBLANK ( MART_FINANCIAL_ANOMALIES[ANOMALY_Z_SCORE] )
			    ),
			    ABS ( MART_FINANCIAL_ANOMALIES[ANOMALY_Z_SCORE] )
			)
