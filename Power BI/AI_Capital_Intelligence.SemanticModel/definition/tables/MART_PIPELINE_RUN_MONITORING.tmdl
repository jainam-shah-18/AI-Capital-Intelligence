table MART_PIPELINE_RUN_MONITORING
	lineageTag: cdd7c348-0271-425c-a0c7-7be7d1e5e91c

	measure 'Latest Pipeline Status' =
			
			CALCULATE(
			    SELECTEDVALUE(
			        MART_PIPELINE_RUN_MONITORING[STATUS]
			    ),
			    MART_PIPELINE_RUN_MONITORING[COMPONENT] = "PIPELINE",
			    MART_PIPELINE_RUN_MONITORING[IS_LATEST_RUN] = TRUE()
			)
		lineageTag: 1a8c244d-24f4-470c-a382-2439307399cf

	measure 'Latest Pipeline Run Time' =
			
			CALCULATE(
			    MAX(MART_PIPELINE_RUN_MONITORING[STARTED_AT]),
			    MART_PIPELINE_RUN_MONITORING[COMPONENT] = "PIPELINE",
			    MART_PIPELINE_RUN_MONITORING[IS_LATEST_RUN] = TRUE()
			)
		formatString: General Date
		lineageTag: ba07c501-7978-4c0b-9048-5ed147256335

	measure 'Latest Rows Loaded' =
			
			CALCULATE(
			    MAX(MART_PIPELINE_RUN_MONITORING[ROWS_LOADED]),
			    MART_PIPELINE_RUN_MONITORING[COMPONENT] = "PIPELINE",
			    MART_PIPELINE_RUN_MONITORING[IS_LATEST_RUN] = TRUE()
			)
		lineageTag: e715f570-b38e-4d6b-b131-8a31af3fe25e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Successful Pipeline Components' =
			
			CALCULATE(
			    COUNTROWS(MART_PIPELINE_RUN_MONITORING),
			    MART_PIPELINE_RUN_MONITORING[STATUS] = "SUCCESS",
			    MART_PIPELINE_RUN_MONITORING[COMPONENT] <> "PIPELINE",
			    MART_PIPELINE_RUN_MONITORING[IS_LATEST_RUN] = TRUE()
			)
		formatString: 0
		lineageTag: 2a6d2bd8-86c2-4af8-a349-9c5585b6c377

	measure 'Failed Pipeline Components' =
			
			CALCULATE(
			    COUNTROWS(MART_PIPELINE_RUN_MONITORING),
			    MART_PIPELINE_RUN_MONITORING[STATUS] <> "SUCCESS",
			    MART_PIPELINE_RUN_MONITORING[COMPONENT] <> "PIPELINE",
			    MART_PIPELINE_RUN_MONITORING[IS_LATEST_RUN] = TRUE()
			)
		formatString: 0
		lineageTag: 8c1073a0-c8c6-4632-8dc3-242fd5865a83

