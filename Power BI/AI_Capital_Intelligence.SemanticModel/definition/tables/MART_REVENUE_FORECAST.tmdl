table MART_REVENUE_FORECAST
	lineageTag: d73ffa97-2928-4bd8-85e7-6f7177f6adb8

	measure 'Forecast Revenue' =
			
			CALCULATE(
			    SUM(MART_REVENUE_FORECAST[FORECAST_REVENUE]),
			    MART_REVENUE_FORECAST[FORECAST_RECORD_TYPE] = "FORECAST"
			)
		lineageTag: d10fb308-372e-4126-bad6-84d4c3e71d98

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Actual Revenue' =
			
			CALCULATE(
			    SUM(MART_REVENUE_FORECAST[ACTUAL_REVENUE]),
			    MART_REVENUE_FORECAST[FORECAST_RECORD_TYPE] = "BACKTEST"
			)
		lineageTag: 43602b14-a649-4972-88e0-6cb48242bf49

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Error' =
			
			CALCULATE(
			    AVERAGE(MART_REVENUE_FORECAST[FORECAST_ERROR]),
			    MART_REVENUE_FORECAST[FORECAST_RECORD_TYPE] = "BACKTEST"
			)
		lineageTag: aa76fa08-60c9-41a7-977a-ed509131ab3c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Absolute Forecast Error' =
			
			CALCULATE(
			    AVERAGE(MART_REVENUE_FORECAST[ABSOLUTE_ERROR]),
			    MART_REVENUE_FORECAST[FORECAST_RECORD_TYPE] = "BACKTEST"
			)
		lineageTag: e4823bff-1fc2-4887-bbf9-11ab753f7b82

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MAPE %' =
			
			CALCULATE(
			    AVERAGE(MART_REVENUE_FORECAST[ABSOLUTE_PERCENTAGE_ERROR]),
			    MART_REVENUE_FORECAST[FORECAST_RECORD_TYPE] = "BACKTEST"
			)
		lineageTag: b8eae7e1-5ec1-4573-82bf-3070cf191255

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Accuracy %' =
			
			DIVIDE(100 - [MAPE %], 100)
		lineageTag: 434ccb41-ff24-4f35-9893-8fdca348c1b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Revenue Row Count' =
			
			CALCULATE(
			    COUNTROWS(MART_REVENUE_FORECAST),
			    MART_REVENUE_FORECAST[FORECAST_RECORD_TYPE] = "FORECAST"
			)
		formatString: 0
		lineageTag: 35e8afa5-f072-47a2-8ea8-4024077929d8

	measure 'Total Forecast Rows' =
			
			COUNTROWS(MART_REVENUE_FORECAST)
		formatString: 0
		lineageTag: 74f10247-57dc-461c-aa93-d846cc98627f

	measure 'Backtest Rows' =
			
			CALCULATE(
			    COUNTROWS(MART_REVENUE_FORECAST),
			    MART_REVENUE_FORECAST[FORECAST_RECORD_TYPE] = "BACKTEST"
			)
		formatString: 0
		lineageTag: 4c1fb960-f5e4-4024-a0f6-14b0a89aa941

	measure 'Forecast Rows' =
			
			CALCULATE(
			    COUNTROWS(MART_REVENUE_FORECAST),
			    MART_REVENUE_FORECAST[FORECAST_RECORD_TYPE] = "FORECAST"
			)
		formatString: 0
		lineageTag: d34def8f-2936-4453-8fb7-2b09445eb9f9

	measure 'Forecast Revenue Nonblank Rows' =
			
			CALCULATE(
			    COUNT(MART_REVENUE_FORECAST[FORECAST_REVENUE]),
			    MART_REVENUE_FORECAST[FORECAST_RECORD_TYPE] = "FORECAST"
			)
		formatString: 0
		lineageTag: a378538f-0766-48fa-aa38-7a4b9a5dda9d

