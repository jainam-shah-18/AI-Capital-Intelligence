table MART_COMPANY_PERFORMANCE
	lineageTag: 9af41486-e43a-4ef0-bb0d-a529a7aec2b2

	measure 'Total Net Income' =
			
			SUM ( MART_COMPANY_PERFORMANCE[NET_INCOME])
		lineageTag: 9c4f8dcd-fb84-44d4-943b-af140127077f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Operating Income' =
			
			SUM ( MART_COMPANY_PERFORMANCE[OPERATING_INCOME])
		lineageTag: 1aa2a794-f8ed-43d6-9f08-401245186d43

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest Reporting Period' =
			
			CALCULATE (
			    MAX ( MART_COMPANY_PERFORMANCE[PERIOD_END] ),
			    REMOVEFILTERS ( MART_COMPANY_PERFORMANCE[PERIOD_END] )
			)
		formatString: General Date
		lineageTag: ff7b25fd-b302-4bb8-adfe-d05fe37d766e

	measure 'Total Revenue' =
			
			VAR LatestDate = [Latest Reporting Period]
			RETURN
			    CALCULATE (
			        SUM ( MART_COMPANY_PERFORMANCE[REVENUE] ),
			        MART_COMPANY_PERFORMANCE[PERIOD_END] = LatestDate
			    )
		lineageTag: 04c93672-ba29-4087-a898-34ca107850ba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Income' =
			
			VAR LatestDate = [Latest Reporting Period]
			RETURN
			    CALCULATE (
			        SUM ( MART_COMPANY_PERFORMANCE[NET_INCOME] ),
			        MART_COMPANY_PERFORMANCE[PERIOD_END] = LatestDate
			    )
		lineageTag: c35b06e3-bf70-4f58-bdee-024ce55ba15b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Operating Income' =
			
			VAR LatestDate = [Latest Reporting Period]
			RETURN
			    CALCULATE (
			        SUM ( MART_COMPANY_PERFORMANCE[OPERATING_INCOME] ),
			        MART_COMPANY_PERFORMANCE[PERIOD_END] = LatestDate
			    )
		lineageTag: 13439890-e2e7-4189-9119-7a535754b4e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Operating Margin' =
			
			DIVIDE (
			    [Operating Income],
			    [Total Revenue]
			)
		lineageTag: 933a0819-81f4-4125-9ca6-dba8820fd266

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue CAGR %' =
			
			VAR StartDate =
			    MIN ( MART_COMPANY_PERFORMANCE[PERIOD_END] )
			VAR EndDate =
			    MAX ( MART_COMPANY_PERFORMANCE[PERIOD_END] )
			VAR StartRevenue =
			    CALCULATE (
			        SUM ( MART_COMPANY_PERFORMANCE[REVENUE] ),
			        MART_COMPANY_PERFORMANCE[PERIOD_END] = StartDate
			    )
			VAR EndRevenue =
			    CALCULATE (
			        SUM ( MART_COMPANY_PERFORMANCE[REVENUE] ),
			        MART_COMPANY_PERFORMANCE[PERIOD_END] = EndDate
			    )
			VAR Years =
			    DIVIDE ( DATEDIFF ( StartDate, EndDate, DAY ), 365.25 )
			RETURN
			    IF (
			        StartRevenue > 0 && EndRevenue > 0 && Years > 0,
			        POWER ( DIVIDE ( EndRevenue, StartRevenue ), DIVIDE ( 1, Years ) ) - 1
			    )
		lineageTag: abf1446a-79bb-4c3e-8a05-ac650e725acb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Income Margin %' =
			
			DIVIDE (
			    SUM ( MART_COMPANY_PERFORMANCE[NET_INCOME] ),
			    SUM ( MART_COMPANY_PERFORMANCE[REVENUE] )
			)
		lineageTag: 80080f76-ad78-432e-8f28-68360e390f57

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue per Quarter' =
			
			DIVIDE (
			    SUM ( MART_COMPANY_PERFORMANCE[REVENUE] ),
			    DISTINCTCOUNT ( MART_COMPANY_PERFORMANCE[PERIOD_END] )
			)
		lineageTag: af202755-e803-4ed0-ac79-f167d07eecdd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Financial Records' = COUNTROWS ( MART_COMPANY_PERFORMANCE )
		lineageTag: 664dd251-a673-44dd-a6e6-c3a9d78e3ffd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

