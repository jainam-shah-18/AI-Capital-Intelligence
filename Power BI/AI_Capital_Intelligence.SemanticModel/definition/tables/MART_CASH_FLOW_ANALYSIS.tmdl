table MART_CASH_FLOW_ANALYSIS
	lineageTag: 8d46d87a-d489-487a-964d-5919c120903b

	measure 'Total Operating Cash Flow' =
			
			SUM ( MART_CASH_FLOW_ANALYSIS[OPERATING_CASH_FLOW] )
		lineageTag: 8cbc8337-496a-4fec-8501-ad5c89496b25

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Capital Expenditure' =
			
			SUM ( MART_CASH_FLOW_ANALYSIS[CAPEX_REPORTED_VALUE] )
		lineageTag: 5c1f38ae-a1bd-4bfa-9210-007ee6e24330

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Operating Cash Flow per Period' =
			
			DIVIDE (
			    [Total Operating Cash Flow],
			    DISTINCTCOUNT ( MART_CASH_FLOW_ANALYSIS[PERIOD_END] )
			)
		lineageTag: 9d03d537-df02-4c7b-93f5-327206efecb3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Operating Cash Flow Periods' =
			
			DISTINCTCOUNT ( MART_CASH_FLOW_ANALYSIS[PERIOD_END] )
		formatString: 0
		lineageTag: d525871a-5e36-40e2-b881-a4b9c1d8c95b

