table MART_COMPANY_COMPARISON
	lineageTag: 83f12f40-7556-41fd-afa0-3ecbe9103c90

	measure 'Revenue Latest Quarter' =
			
			VAR LatestPeriod =
			    CALCULATE (
			        MAX ( MART_COMPANY_COMPARISON[PERIOD_END] ),
			        REMOVEFILTERS ( MART_COMPANY_COMPARISON[PERIOD_END] )
			    )
			RETURN
			    CALCULATE (
			        SUM ( MART_COMPANY_COMPARISON[REVENUE] ),
			        MART_COMPANY_COMPARISON[PERIOD_END] = LatestPeriod
			    )
		lineageTag: d8eb76b4-a700-44c7-aec9-ce16788fbec4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Operating Income Latest Quarter' =
			
			VAR LatestPeriod =
			    CALCULATE (
			        MAX ( MART_COMPANY_COMPARISON[PERIOD_END] ),
			        REMOVEFILTERS ( MART_COMPANY_COMPARISON[PERIOD_END] )
			    )
			RETURN
			    CALCULATE (
			        SUM ( MART_COMPANY_COMPARISON[OPERATING_INCOME] ),
			        MART_COMPANY_COMPARISON[PERIOD_END] = LatestPeriod
			    )
		lineageTag: 0eacf5f3-b06a-4fa9-8bc8-ddbab771c8da

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Income Latest Quarter' =
			
			VAR LatestPeriod =
			    CALCULATE (
			        MAX ( MART_COMPANY_COMPARISON[PERIOD_END] ),
			        REMOVEFILTERS ( MART_COMPANY_COMPARISON[PERIOD_END] )
			    )
			RETURN
			    CALCULATE (
			        SUM ( MART_COMPANY_COMPARISON[NET_INCOME] ),
			        MART_COMPANY_COMPARISON[PERIOD_END] = LatestPeriod
			    )
		lineageTag: ae9eea2b-c9b3-42b8-b83b-7be8e63e8dfc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Operating Margin Latest Quarter' =
			
			DIVIDE (
			    [Operating Income Latest Quarter],
			    [Revenue Latest Quarter]
			)
		lineageTag: 25934f07-5d39-43af-bf82-50087a982073

		annotation PBI_FormatHint = {"isGeneralNumber":true}

